# 広告ページのURL（別オリジン）。未設定なら広告枠を表示しない。
# 広告は sandbox 付きの iframe で表示し、入力画面には表示しない。
VITE_AD_URL=

# PDF作成APIのURL。空ならPDFもブラウザの中で作る（既定。GitHub Pages など静的サイトで動く）。
# AWS（Lambda）でPDFを作る場合は /api/pdf を設定する（npm run build:aws は .env.aws で設定済み）。
VITE_PDF_API=

# ローカル開発時の /api 転送先（vite dev のみ）
API_PROXY_TARGET=http://localhost:9000
